@page "/slates/{SlateId:guid}"
@attribute [Authorize(Policy = "SystemAdministrator")]
@rendermode InteractiveServer
@inject AdminPortalService Admin
@inject IJSRuntime JS

<PageTitle>Weekly Slate</PageTitle>
<div class="page-heading"><div><p class="eyebrow">Slate review</p><h1>Weekly slate</h1></div>
    @if (slate?.Status == "Draft") { <a class="button" href="/slates/@SlateId/edit">Edit draft</a> }</div>

@if (loading) { <p role="status">Loading slate…</p> }
else if (error is not null) { <p class="notice error" role="alert">@error</p><a href="/slates">Back to slates</a> }
else if (slate is not null)
{
    <section class="card section-card">
        <dl class="detail-grid"><div><dt>League</dt><dd>@slate.LeagueName</dd></div><div><dt>Season</dt><dd>@slate.Season</dd></div>
            <div><dt>Week</dt><dd>@slate.Week</dd></div><div><dt>Status</dt><dd>@slate.Status</dd></div>
            <div><dt>Games</dt><dd>@slate.Games.Count / 10</dd></div>
            <div><dt>Readiness</dt><dd>@SlateReadinessPresentation.Label(slate.Status, slate.ReadyForPublishing)</dd></div>
            @if (slate.LockUtc is not null)
            {
                <div><dt>Lock time (@(timeZoneId ?? "local timezone unavailable"))</dt>
                    <dd>@(timeZoneId is null ? "Browser timezone unavailable" : LocalLockTimeConverter.FormatLocal(slate.LockUtc.Value, timeZoneId))</dd></div>
            }
            @if (slate.PublishedUtc is not null) { <div><dt>Published (UTC)</dt><dd>@Kickoff(slate.PublishedUtc)</dd></div> }
        </dl>
    </section>
    @if (publishMessage is not null) { <p class="notice" role="status">@publishMessage</p> }
    @if (slate.Status == "Draft")
    {
        <section class="card section-card">
            <h2>Publish slate</h2>
            @if (!slate.ReadyForPublishing)
            { <p class="empty-state">Select exactly 10 eligible games before publishing.</p> }
            else
            {
                @if (timeZoneId is null)
                {
                    <p class="muted" role="status">@(inputValidationMessage ?? "Detecting your browser timezone…")</p>
                }
                else
                {
                    <label>Lock time (local · @timeZoneId)
                        <input type="datetime-local" step="any" value="@lockLocalInput" @onchange="LockTimeChanged" disabled="@publishing" />
                    </label>
                    <p class="muted">Times use @timeZoneId. The server stores and enforces the converted UTC instant. The lock must be in the future and no later than the earliest selected kickoff.</p>
                    @if (inputValidationMessage is not null) { <p class="notice error" role="alert">@inputValidationMessage</p> }
                    @if (ambiguousTimeNotice is not null) { <p class="notice" role="status">@ambiguousTimeNotice</p> }
                    @if (ambiguousOccurrences.Count == 2)
                    {
                        <fieldset>
                            <legend>This local time occurs twice. Select the intended occurrence:</legend>
                            <label><input type="radio" name="ambiguous-lock-occurrence" value="earlier"
                                checked="@(ambiguousChoice == AmbiguousTimeOccurrence.Earlier)" @onchange="SelectEarlierOccurrence" />
                                First occurrence — @LocalLockTimeConverter.FormatLocal(ambiguousOccurrences[0], timeZoneId)</label>
                            <label><input type="radio" name="ambiguous-lock-occurrence" value="later"
                                checked="@(ambiguousChoice == AmbiguousTimeOccurrence.Later)" @onchange="SelectLaterOccurrence" />
                                Second occurrence — @LocalLockTimeConverter.FormatLocal(ambiguousOccurrences[1], timeZoneId)</label>
                        </fieldset>
                    }
                }
                <button class="button" disabled="@(publishing || timeZoneId is null || inputValidationMessage is not null)" @onclick="Publish">@(publishing ? "Publishing…" : "Publish slate")</button>
            }
        </section>
    }
    <section class="card section-card"><h2>Ordered games</h2>
        @if (slate.Games.Count == 0) { <p class="empty-state">No games have been selected.</p> }
        else { <div class="table-wrap"><table><thead><tr><th>Order</th><th>Kickoff (UTC)</th><th>Matchup</th><th>Status</th><th>Score</th></tr></thead><tbody>
            @foreach (var game in slate.Games.Select((item, index) => (item, index)))
            { <tr><td>@(game.index + 1)</td><td>@Kickoff(game.item.KickoffUtc)</td><td>@game.item.AwayTeam at @game.item.HomeTeam</td><td>@game.item.Status</td><td>@Score(game.item)</td></tr> }
        </tbody></table></div> }
    </section>
    <p><a href="/slates">← Weekly slates</a></p>
}

@code {
    [Parameter] public Guid SlateId { get; set; }
    private AdminSlateDto? slate;
    private bool loading = true;
    private bool publishing;
    private string? error;
    private string? publishMessage;
    private string? timeZoneId;
    private string lockLocalInput = "";
    private string? inputValidationMessage;
    private string? ambiguousTimeNotice;
    private IReadOnlyList<DateTimeOffset> ambiguousOccurrences = [];
    private AmbiguousTimeOccurrence? ambiguousChoice;
    private Guid? loadedSlateId;
    protected override async Task OnParametersSetAsync()
    {
        loading = true; error = null;
        try
        {
            slate = await Admin.GetSlateAsync(SlateId);
            if (loadedSlateId != slate.Id)
            {
                loadedSlateId = slate.Id;
                lockLocalInput = "";
                inputValidationMessage = null;
                ambiguousTimeNotice = null;
                ambiguousOccurrences = [];
                ambiguousChoice = null;
                InitializeDefaultLockInput();
            }
        }
        catch (Exception) { error = "This slate could not be loaded."; }
        finally { loading = false; }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            timeZoneId = await JS.InvokeAsync<string>("saturdayScoutAdminTime.getTimeZone");
            if (string.IsNullOrWhiteSpace(timeZoneId)) timeZoneId = null;
            InitializeDefaultLockInput();
        }
        catch (Exception exception) when (exception is JSException or InvalidOperationException)
        {
            timeZoneId = null;
            inputValidationMessage = "Your browser timezone could not be detected. Reload the page and try again.";
        }
        StateHasChanged();
    }
    private void InitializeDefaultLockInput()
    {
        if (timeZoneId is null || slate is null || !string.IsNullOrEmpty(lockLocalInput)) return;
        if (slate.LockUtc is { } existingLockUtc)
        {
            lockLocalInput = LocalLockTimeConverter.ToLocalInput(existingLockUtc, timeZoneId);
            ambiguousOccurrences = LocalLockTimeConverter.GetAmbiguousUtcOccurrences(lockLocalInput, timeZoneId);
            if (ambiguousOccurrences.Count == 2)
            {
                var existingUtc = existingLockUtc.ToUniversalTime();
                ambiguousChoice = existingUtc == ambiguousOccurrences[0]
                    ? AmbiguousTimeOccurrence.Earlier
                    : AmbiguousTimeOccurrence.Later;
            }
            return;
        }
        if (!slate.ReadyForPublishing) return;
        var earliest = slate.Games.Min(x => x.KickoffUtc);
        if (earliest is not null)
        {
            try
            {
                lockLocalInput = LocalLockTimeConverter.CreateDefaultLocalInput(earliest.Value, timeZoneId);
                ambiguousOccurrences = LocalLockTimeConverter.GetAmbiguousUtcOccurrences(lockLocalInput, timeZoneId);
                if (ambiguousOccurrences.Count == 2)
                    inputValidationMessage = "This default time occurs twice. Choose the intended occurrence before publishing.";
            }
            catch (Exception exception) when (exception is ArgumentException or InvalidTimeZoneException or TimeZoneNotFoundException or InvalidOperationException)
            {
                inputValidationMessage = "A safe default could not be calculated for your browser timezone. Enter a different local time or reload.";
            }
        }
    }
    private async Task Publish()
    {
        if (slate is null || slate.Status != "Draft" || !slate.ReadyForPublishing) return;
        if (timeZoneId is null) { inputValidationMessage = "Your browser timezone is unavailable."; return; }
        LocalLockTimeConversion conversion;
        try { conversion = LocalLockTimeConverter.ConvertToUtc(lockLocalInput, timeZoneId, ambiguousChoice); }
        catch (ArgumentException exception) { inputValidationMessage = exception.Message; return; }
        var lockUtc = conversion.LockUtc;
        publishing = true; publishMessage = null;
        try
        {
            slate = await Admin.PublishSlateAsync(SlateId, new PublishAdminSlateRequest(lockUtc, slate.Version));
            publishMessage = conversion.IsAmbiguous
                ? $"Slate published using the {(ambiguousChoice == AmbiguousTimeOccurrence.Earlier ? "first" : "second")} occurrence of the ambiguous local time. It is now read-only."
                : "Slate published. It is now read-only.";
        }
        catch (Exception) { publishMessage = "The slate was not published. Check the lock time and reload if it changed elsewhere."; }
        finally { publishing = false; }
    }
    private void LockTimeChanged(ChangeEventArgs args)
    {
        var rawValue = args.Value?.ToString() ?? "";
        lockLocalInput = rawValue.Trim();
        inputValidationMessage = null;
        ambiguousTimeNotice = null;
        ambiguousOccurrences = [];
        ambiguousChoice = null;
        try
        {
            ambiguousOccurrences = LocalLockTimeConverter.GetAmbiguousUtcOccurrences(lockLocalInput, timeZoneId);
            if (ambiguousOccurrences.Count == 2)
                inputValidationMessage = "This local time occurs twice. Choose the intended occurrence before publishing.";
            else
                _ = LocalLockTimeConverter.ConvertToUtc(lockLocalInput, timeZoneId);
        }
        catch (ArgumentException exception) { inputValidationMessage = exception.Message; }
    }
    private void SelectEarlierOccurrence()
    {
        ambiguousChoice = AmbiguousTimeOccurrence.Earlier;
        inputValidationMessage = null;
        ambiguousTimeNotice = "The first occurrence is selected; the displayed UTC offset identifies the chosen instant.";
    }
    private void SelectLaterOccurrence()
    {
        ambiguousChoice = AmbiguousTimeOccurrence.Later;
        inputValidationMessage = null;
        ambiguousTimeNotice = "The second occurrence is selected; the displayed UTC offset identifies the chosen instant.";
    }
    private static string Kickoff(DateTimeOffset? value) => value?.ToUniversalTime().ToString("yyyy-MM-dd HH:mm 'UTC'") ?? "Time TBD";
    private static string Score(AdminGameDto game) => game.HomeScore is null || game.AwayScore is null ? "—" : $"{game.AwayScore}–{game.HomeScore}";
}
