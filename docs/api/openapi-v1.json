            "type": "string"
          },
          "season": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "week": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "PickDto": {
        "required": [
          "gameId",
          "selectedTeamId",
          "confidenceRank"
        ],
        "type": "object",
        "properties": {
          "gameId": {
            "type": "string",
            "format": "uuid"
          },
          "selectedTeamId": {
            "type": "string",
            "format": "uuid"
          },
          "confidenceRank": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "PublishAdminSlateRequest": {
        "required": [
          "lockUtc",
          "expectedVersion"
        ],
        "type": "object",
        "properties": {
          "lockUtc": {
            "type": "string",
            "format": "date-time"
          },
          "expectedVersion": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          }
        }
      },
      "PublishSlateRequest": {
        "required": [
          "lockUtc"
        ],
        "type": "object",
        "properties": {
          "lockUtc": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RandomizeAdminSlateRequest": {
        "required": [
          "expectedVersion"
        ],
        "type": "object",
        "properties": {
          "expectedVersion": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          }
        }
      },
      "SavePicksRequest": {
        "required": [
          "picks",
          "expectedVersion"
        ],
        "type": "object",
        "properties": {
          "picks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PickDto"
            }
          },
          "expectedVersion": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int64"
          }
        }
      },
      "SetSlateGamesRequest": {
        "required": [
          "gameIds"
        ],
        "type": "object",
        "properties": {
          "gameIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "SubmitRequest": {
        "required": [
          "expectedVersion"
        ],
        "type": "object",
        "properties": {
          "expectedVersion": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int64"
          }
        }
      },
      "UpdateAdminSlateGamesRequest": {
        "required": [
          "gameIds",
          "expectedVersion"
        ],
        "type": "object",
        "properties": {
          "gameIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "expectedVersion": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          }
        }
